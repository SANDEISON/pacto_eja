digraph banco {
graph [rankdir=LR, bgcolor="white", pad=0.5, nodesep=0.45, ranksep=1.6, overlap=false, sep="+35", splines=true, outputorder=edgesfirst, fontname="Arial", fontsize=24, labelloc=t, label="PACTO EJA • Relacionamento do banco de dados\nModelos Django atuais • Títulos: Meta.verbose_name\nPK: chave primária | FK: chave estrangeira | UQ: único | ?: aceita NULL\nLinhas: FK → PK • ponta simples = 1 • ponta em leque = muitos • intermediárias representam N:N"];
